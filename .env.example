# --- HenrikDev API (unofficial Valorant API) ---
# Get a free key at https://api.henrikdev.xyz/dashboard (requires Discord login)
HENRIK_API_KEY=

# --- Target Premier team ---
# Your team's Riot-style name + tag, e.g. name "THEIRONONES" tag "IRON"
PREMIER_TEAM_NAME=THEIRONONES
PREMIER_TEAM_TAG=IRON
# Region: na, eu, ap, kr, latam, br
PREMIER_REGION=na

# --- Server ---
PORT=8000
# Comma-separated origins allowed to call the API (the Vite dev server)
CORS_ORIGINS=http://localhost:5173

# --- Analysis tuning (optional; sensible defaults in config.py) ---
# Max matches to pull for the season report (keeps within rate limits)
MAX_MATCHES=25
# Trade window in milliseconds (a death is "traded" if the killer dies within this window)
TRADE_WINDOW_MS=3000

# --- Planning page: Discord built-in poll availability ---
# Create a Discord bot, add it to the server, and grant it read access to the poll channel.
# Enable Message Content Intent for the bot so Discord includes poll objects in messages.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# How far back to scan while finding the latest 3 Discord poll messages.
DISCORD_POLL_SCAN_LIMIT=500
